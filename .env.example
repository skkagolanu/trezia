# Site — used for metadataBase, canonical/OG tags, and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# NEVER expose this in the browser — server-side API routes only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend email
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=contact@example.test

# Cloudflare R2. Read legacy objects from R2_BUCKET_NAME and write new artifacts
# to R2_PRIVATE_BUCKET_NAME. Both configured buckets must be private.
R2_ACCOUNT_ID=your_cloudflare_account_id
# Required only for a jurisdiction-restricted bucket: eu, us, or fedramp.
# Leave unset for an unrestricted bucket. The AWS SDK region remains "auto".
# Set each bucket independently. Leave blank for an unrestricted bucket.
R2_LEGACY_JURISDICTION=
R2_PRIVATE_JURISDICTION=
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=legacy-compatibility-artifacts
R2_PRIVATE_BUCKET_NAME=trezia-private-artifacts

# Vercel Cron authentication
CRON_SECRET=generate_with_openssl_rand_hex_32

# Groq assistant model provider — console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
# Deployment-wide daily ceiling on assistant calls across every society, on top
# of each society's own per-user/per-society daily limits (Settings → Assistant).
# Defaults to 800 if unset.
AGENT_GLOBAL_DAILY_LIMIT=800

# Snapshot pruning — the daily cron reports tiered (7-daily/4-weekly/12-monthly)
# prune candidates by default and deletes nothing. Set to true only after the
# reported candidate set has been reviewed.
SNAPSHOT_TIERED_PRUNING_ENABLED=false

# Razorpay (resident online payments) — optional; the society's own Razorpay
# account. Resident online payments stay disabled until all three are set.
RAZORPAY_KEY_ID=
# Server-side only — never NEXT_PUBLIC
RAZORPAY_KEY_SECRET=
# The secret you set when creating the webhook in the Razorpay dashboard; used
# to verify webhook signatures
RAZORPAY_WEBHOOK_SECRET=
# Required when using the legacy three variables above; prevents one deployment
# account from being silently used by every society.
RAZORPAY_SOCIETY_ID=
# Preferred multi-society form. Store this as one encrypted deployment secret:
# {"<society-uuid>":{"keyId":"...","keySecret":"...","webhookSecret":"..."}}
RAZORPAY_SOCIETY_ACCOUNTS_JSON=

# Optional — Web Push notifications (dues reminders, payment-claim status).
# Feature stays dark until all three are set. Generate a VAPID keypair once with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a mailto: or https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional — Sentry error tracking (no-ops safely if unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Multi-society routing. Enable for membership-RLS databases (migrations 044-046).
# The proxy supplies the society slug used by tenant-scoped policies.
MULTI_SOCIETY_ROUTING_ENABLED=true
# Enable society creation and platform administration workflows.
PLATFORM_CREATION_ENABLED=true
