{
  "name": "society-treasurer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:rls": "jest --config jest.rls.config.cjs --runInBand",
    "test:rls:local": "node scripts/rls-local.mjs",
    "restore:drill": "node scripts/rehearse-restore.mjs",
    "restore:snapshot": "node scripts/restore-snapshot.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "r2:migrate-private": "node scripts/r2-private-migration.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "prepare": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "ci:check": "tsc --noEmit && eslint . --max-warnings 0 && audit-ci --config .audit-ci.json && npm test -- --coverage",
    "ci:secrets": "gitleaks dir --no-banner --redact=100 --config .gitleaks.toml .",
    "ci:full": "npm run ci:check && npm run build && npm run ci:secrets",
    "verify:production": "node scripts/verify-production-artifacts.mjs",
    "release:gate": "npm run ci:full && npm run verify:production && npm run test:visual && npm run test:rls:local && npm run restore:drill",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.8",
    "@ai-sdk/react": "^4.0.23",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/busboy": "^1.5.4",
    "ai": "^7.0.22",
    "busboy": "^1.6.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "focus-trap-react": "^12.0.3",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-nprogress-bar": "^2.4.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "jsdom": "^27.0.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "test-exclude": "^8.0.0",
    "sharp": "^0.35.3",
    "fast-uri": "^3.1.5",
    "next": {
      "postcss": "^8.5.23"
    },
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "audit-ci": "^7.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pg": "^8.22.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
