{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private lab artifacts and finite CodeBuild workers; isolated from production",
  "Metadata": {},
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "BoundedLabRetention",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 1
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Temporary synthetic source and evidence",
          "must": [
            "Export evidence before deletion"
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtifactPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "HTTPS-only artifact access",
          "must": [
            "Lab resources only"
          ]
        }
      }
    },
    "BuildLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/codebuild/${AWS::StackName}"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bounded worker logs",
          "must": [
            "Lab resources only"
          ]
        }
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "LabArtifactsAndLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Artifacts",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BuildLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Finite builds can only read and write the lab artifact bucket",
          "must": [
            "Lab resources only"
          ]
        }
      }
    },
    "Worker": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "TimeoutInMinutes": 45,
        "QueuedTimeoutInMinutes": 10,
        "ConcurrentBuildLimit": 1,
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Source": {
          "Type": "S3",
          "Location": {
            "Fn::Sub": "${Artifacts}/source.zip"
          },
          "BuildSpec": "aws_lab/buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_MEDIUM",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "LAB_ARTIFACT_BUCKET",
              "Value": {
                "Ref": "Artifacts"
              }
            }
          ]
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "BuildLogs"
            }
          }
        },
        "Tags": [
          {
            "Key": "Purpose",
            "Value": "TreziaSyntheticRecoveryLab"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Cloud-only restore and validation worker; no production credentials",
          "must": [
            "No VPC or NAT gateway",
            "No scheduled builds",
            "Finite timeout"
          ]
        }
      }
    }
  },
  "Outputs": {
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      },
      "Description": "ArtifactBucket for the isolated lab"
    },
    "Worker": {
      "Value": {
        "Ref": "Worker"
      },
      "Description": "Worker for the isolated lab"
    },
    "BuildRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BuildRole",
          "Arn"
        ]
      },
      "Description": "BuildRoleArn for the isolated lab"
    }
  }
}
